-static int malloc_inlk(MLOCK_T *lk) {
-  atomic_store_explicit(lk, 0, memory_order_relaxed);
-  return 0;
-}
-
-static int malloc_wipe(MLOCK_T *lk) {
-  atomic_store_explicit(lk, 0, memory_order_relaxed);
-  return 0;
-}
